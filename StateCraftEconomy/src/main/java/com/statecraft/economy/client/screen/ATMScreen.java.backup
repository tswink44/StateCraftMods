package com.statecraft.economy.client.screen;

import com.mojang.blaze3d.systems.RenderSystem;
import com.statecraft.economy.StateCraftEconomy;
import com.statecraft.economy.core.Bank;
import com.statecraft.economy.core.EconomyManager;
import com.statecraft.economy.gui.ATMMenu;
import com.statecraft.economy.network.NetworkHandler;
import com.statecraft.economy.network.packets.ATMTransactionPacket;
import net.minecraft.client.gui.GuiGraphics;
import net.minecraft.client.gui.components.Button;
import net.minecraft.client.gui.components.EditBox;
import net.minecraft.client.gui.screens.inventory.AbstractContainerScreen;
import net.minecraft.network.chat.Component;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.world.entity.player.Inventory;

/**
 * Client-side GUI screen for the ATM
 * Allows deposits, withdrawals, transfers, and balance checks
 */
public class ATMScreen extends AbstractContainerScreen<ATMMenu> {
    private static final ResourceLocation TEXTURE =
        new ResourceLocation(StateCraftEconomy.MOD_ID, "textures/gui/atm.png");

    private static final int GUI_WIDTH = 176;
    private static final int GUI_HEIGHT = 166;

    private EditBox amountInput;
    private EditBox recipientInput;
    private Button depositButton;
    private Button withdrawButton;
    private Button transferButton;
    private Button checkBalanceButton;

    private double currentBalance = 0.0;
    private String statusMessage = "";
    private int statusMessageTicks = 0;

    private enum Mode {
        MAIN,
        DEPOSIT,
        WITHDRAW,
        TRANSFER
    }

    private Mode currentMode = Mode.MAIN;

    public ATMScreen(ATMMenu menu, Inventory playerInventory, Component title) {
        super(menu, playerInventory, title);
        this.imageWidth = GUI_WIDTH;
        this.imageHeight = GUI_HEIGHT;
    }

    @Override
    protected void init() {
        super.init();

        int x = (width - imageWidth) / 2;
        int y = (height - imageHeight) / 2;

        // Amount input field
        amountInput = new EditBox(this.font, x + 10, y + 20, 80, 20, Component.literal("Amount"));
        amountInput.setMaxLength(10);
        amountInput.setVisible(false);
        addRenderableWidget(amountInput);

        // Recipient input field (for transfers)
        recipientInput = new EditBox(this.font, x + 10, y + 45, 156, 20, Component.literal("Recipient"));
        recipientInput.setMaxLength(16);
        recipientInput.setVisible(false);
        addRenderableWidget(recipientInput);

        // Main menu buttons
        checkBalanceButton = Button.builder(Component.literal("Check Balance"),
            btn -> checkBalance())
            .bounds(x + 10, y + 20, 156, 20)
            .build();
        addRenderableWidget(checkBalanceButton);

        depositButton = Button.builder(Component.literal("Deposit (Use Slot)"),
            btn -> setMode(Mode.DEPOSIT))
            .bounds(x + 10, y + 45, 156, 20)
            .build();
        addRenderableWidget(depositButton);

        withdrawButton = Button.builder(Component.literal("Withdraw"),
            btn -> setMode(Mode.WITHDRAW))
            .bounds(x + 10, y + 70, 76, 20)
            .build();
        addRenderableWidget(withdrawButton);

        transferButton = Button.builder(Component.literal("Transfer"),
            btn -> setMode(Mode.TRANSFER))
            .bounds(x + 90, y + 70, 76, 20)
            .build();
        addRenderableWidget(transferButton);

        updateButtonVisibility();
    }

    private void setMode(Mode mode) {
        currentMode = mode;
        updateButtonVisibility();
        statusMessage = "";
        statusMessageTicks = 0;

        if (mode == Mode.DEPOSIT) {
            // For deposit, we'll use the deposit slot
            setStatusMessage("Place currency in the slot and click Confirm", 100);
        } else if (mode == Mode.WITHDRAW) {
            setStatusMessage("Enter amount to withdraw", 100);
            amountInput.setValue("");
        } else if (mode == Mode.TRANSFER) {
            setStatusMessage("Enter recipient and amount", 100);
            amountInput.setValue("");
            recipientInput.setValue("");
        }
    }

    private void updateButtonVisibility() {
        boolean isMain = currentMode == Mode.MAIN;

        checkBalanceButton.visible = isMain;
        depositButton.visible = isMain;
        withdrawButton.visible = isMain;
        transferButton.visible = isMain;

        amountInput.setVisible(!isMain && currentMode != Mode.DEPOSIT);
        recipientInput.setVisible(currentMode == Mode.TRANSFER);

        // Remove old action buttons if they exist
        clearWidgets();
        addRenderableWidget(amountInput);
        addRenderableWidget(recipientInput);
        addRenderableWidget(checkBalanceButton);
        addRenderableWidget(depositButton);
        addRenderableWidget(withdrawButton);
        addRenderableWidget(transferButton);

        int x = (width - imageWidth) / 2;
        int y = (height - imageHeight) / 2;

        if (!isMain) {
            // Add Confirm and Cancel buttons
            Button confirmButton = Button.builder(Component.literal("Confirm"),
                btn -> executeAction())
                .bounds(x + 10, y + 95, 76, 20)
                .build();
            addRenderableWidget(confirmButton);

            Button cancelButton = Button.builder(Component.literal("Cancel"),
                btn -> setMode(Mode.MAIN))
                .bounds(x + 90, y + 95, 76, 20)
                .build();
            addRenderableWidget(cancelButton);
        }
    }

    private void checkBalance() {
        NetworkHandler.sendToServer(new ATMTransactionPacket(
            ATMTransactionPacket.Action.CHECK_BALANCE, 0, ""));
    }

    private void executeAction() {
        switch (currentMode) {
            case DEPOSIT -> {
                double value = menu.getDepositValue();
                if (value > 0) {
                    NetworkHandler.sendToServer(new ATMTransactionPacket(
                        ATMTransactionPacket.Action.DEPOSIT, value, ""));
                    setStatusMessage("Deposited " + formatCurrency(value), 100);
                } else {
                    setStatusMessage("No currency in slot!", 100);
                }
                setMode(Mode.MAIN);
            }
            case WITHDRAW -> {
                try {
                    double amount = Double.parseDouble(amountInput.getValue());
                    if (amount > 0) {
                        NetworkHandler.sendToServer(new ATMTransactionPacket(
                            ATMTransactionPacket.Action.WITHDRAW, amount, ""));
                        setStatusMessage("Withdrawing " + formatCurrency(amount) + "...", 100);
                    } else {
                        setStatusMessage("Amount must be positive!", 100);
                    }
                } catch (NumberFormatException e) {
                    setStatusMessage("Invalid amount!", 100);
                }
                setMode(Mode.MAIN);
            }
            case TRANSFER -> {
                try {
                    double amount = Double.parseDouble(amountInput.getValue());
                    String recipient = recipientInput.getValue();
                    if (amount > 0 && !recipient.isEmpty()) {
                        NetworkHandler.sendToServer(new ATMTransactionPacket(
                            ATMTransactionPacket.Action.TRANSFER, amount, recipient));
                        setStatusMessage("Transferring " + formatCurrency(amount) + " to " + recipient + "...", 100);
                    } else {
                        setStatusMessage("Invalid amount or recipient!", 100);
                    }
                } catch (NumberFormatException e) {
                    setStatusMessage("Invalid amount!", 100);
                }
                setMode(Mode.MAIN);
            }
        }
    }

    @Override
    public void render(GuiGraphics graphics, int mouseX, int mouseY, float partialTick) {
        renderBackground(graphics);
        super.render(graphics, mouseX, mouseY, partialTick);
        renderTooltip(graphics, mouseX, mouseY);
    }

    @Override
    protected void renderBg(GuiGraphics graphics, float partialTick, int mouseX, int mouseY) {
        RenderSystem.setShaderColor(1.0F, 1.0F, 1.0F, 1.0F);
        int x = (width - imageWidth) / 2;
        int y = (height - imageHeight) / 2;
        graphics.blit(TEXTURE, x, y, 0, 0, imageWidth, imageHeight);
    }

    @Override
    protected void renderLabels(GuiGraphics graphics, int mouseX, int mouseY) {
        // Get bank info
        Bank bank = EconomyManager.getInstance().getBankRegistry().getBank(menu.getBankId());
        String bankName = bank != null ? bank.getDisplayName() : "ATM";

        // Draw title
        graphics.drawString(this.font, bankName, 8, 6, 0x404040, false);

        // Draw balance
        graphics.drawString(this.font, "Balance: " + formatCurrency(currentBalance),
            8, imageHeight - 94, 0x3F3F3F, false);

        // Draw status message
        if (statusMessageTicks > 0) {
            graphics.drawString(this.font, statusMessage, 8, imageHeight - 84, 0x00AA00, false);
        }

        // Draw inventory label
        graphics.drawString(this.font, this.playerInventoryTitle, 8, imageHeight - 94 + 3, 0x404040, false);
    }

    @Override
    public void containerTick() {
        super.containerTick();
        if (statusMessageTicks > 0) {
            statusMessageTicks--;
        }
        if (amountInput != null) {
            amountInput.tick();
        }
        if (recipientInput != null) {
            recipientInput.tick();
        }
    }

    public void setBalance(double balance) {
        this.currentBalance = balance;
    }

    public void setStatusMessage(String message, int ticks) {
        this.statusMessage = message;
        this.statusMessageTicks = ticks;
    }

    private String formatCurrency(double amount) {
        return String.format("$%.2f", amount);
    }

    @Override
    public boolean keyPressed(int keyCode, int scanCode, int modifiers) {
        if (amountInput != null && amountInput.isFocused()) {
            return amountInput.keyPressed(keyCode, scanCode, modifiers);
        }
        if (recipientInput != null && recipientInput.isFocused()) {
            return recipientInput.keyPressed(keyCode, scanCode, modifiers);
        }
        return super.keyPressed(keyCode, scanCode, modifiers);
    }
}

